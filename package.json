{
  "name": "chatimall-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Chatimall app(APK) AND desktop app for Windows",
  "author": "Chatimall",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "android:sync": "vite build && node scripts/patch-android.mjs && cap sync android",
    "android:open": "cap open android",
    "android:patch": "node scripts/patch-android.mjs",
    "apk:debug": "node scripts/build-apk.mjs",
    "build:windows": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor-firebase/analytics": "^8.6.0",
    "@capacitor-firebase/remote-config": "^8.6.0",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capgo/capacitor-native-biometric": "^8.7.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "firebase": "^12.6.0",
    "lucide-react": "^0.446.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "com.chatimall.app",
    "productName": "Chatimall",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "!node_modules/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "assets/images/chatimall.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Chatimall-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/images/chatimall.ico",
      "uninstallerIcon": "assets/images/chatimall.ico",
      "installerSidebar": "assets/images/chatimall-installer-sidebar.bmp",
      "uninstallerSidebar": "assets/images/chatimall-installer-sidebar.bmp",
      "include": "electron/installer.nsh"
    }
  }
}
